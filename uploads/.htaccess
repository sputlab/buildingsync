# BuildingSync — gli allegati si scaricano solo tramite allegato.php (con controllo permessi)
Require all denied
Options -Indexes -ExecCGI
# Difesa aggiuntiva: nessuno script eseguibile in questa cartella
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
